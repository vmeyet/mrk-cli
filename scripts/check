#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
cargo fmt --all --check
cargo clippy --all-targets -- -D warnings
cargo test --no-default-features
cargo test --all-targets
cargo deny --all-features check --hide-inclusion-graph
cargo machete
# Dirty allowed so the check runs before a commit; CI checks a clean checkout.
cargo publish --dry-run --locked --allow-dirty

msrv=$(cargo metadata --no-deps --format-version 1 | jq -r '.packages[0].rust_version')
if rustup toolchain list | grep -q "^$msrv-"; then
  cargo "+$msrv" check --all-targets --locked
  cargo "+$msrv" check --no-default-features --locked
else
  echo "skipped the MSRV check: install it with \`rustup toolchain install $msrv\`" >&2
fi

target=x86_64-unknown-linux-musl
if command -v musl-gcc >/dev/null && rustup target list --installed | grep -qx "$target"; then
  cargo build --profile dist --target "$target" --locked
  "target/$target/dist/mrk" --version
else
  echo "skipped the $target release build: needs musl-gcc and \`rustup target add $target\`" >&2
fi
